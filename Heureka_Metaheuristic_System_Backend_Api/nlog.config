<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
	  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  autoReload="true">


	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>


	<targets>
		<target xsi:type="File" name="allfile" fileName ="./ApiLogs/nlog-all-${shortdate}.log"
		  layout="${longdate}|${event-properties:item=EventId_Id}|${level:uppercase=true}|${logger}|${message} ${exception:format=type}" />
		<target xsi:type="File" name="exceptions" fileName ="./ApiLogs/nlog-all-exceptions-${shortdate}.log"
		  layout="${longdate}|${event-properties:item=EventId_Id}|${level:uppercase=true}|${logger}|${message} ${exception:format=type}" />
	</targets>
	<rules>
		<logger name="*" minlevel="Trace" writeTo="allfile" />
		<logger name="Heureka_Metaheuristic_System_Backend_Api." minlevel="Error" writeTo="exceptions" />
	</rules>
</nlog>